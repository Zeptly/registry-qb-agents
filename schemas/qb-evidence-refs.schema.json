{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zeptly:qb:schema:evidence-refs:v1",
  "title": "QB Evidence References",
  "description": "Append-only index of POINTERS to machine evidence about one QB version. Raw sessions, tapes and trajectories live in the evidence store (Supabase/Cortex), never in Git.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "for", "refs"],
  "properties": {
    "apiVersion": { "const": "qb.zeptly.dev/v1" },
    "kind": { "const": "QBEvidenceRefs" },
    "for": { "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/qbPinnedRef" },
    "refs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "uri", "capturedAt", "blueprintDigest", "summary"],
        "properties": {
          "id": { "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/slug" },
          "type": { "enum": ["eval-run", "session-sample", "trajectory-set", "incident", "benchmark", "human-review"] },
          "uri": { "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/evidenceUri" },
          "contentDigest": { "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/digest" },
          "capturedAt": { "type": "string", "format": "date-time" },
          "blueprintDigest": { "description": "Digest of the exact blueprint this evidence was gathered against.", "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/digest" },
          "gate": { "enum": ["candidate", "canary", "stable"], "description": "For eval-runs: the promotion gate this run was evaluated against." },
          "result": { "enum": ["pass", "fail", "inconclusive"] },
          "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
          "redaction": { "enum": ["none", "pseudonymised", "aggregate-only"] },
          "summary": { "type": "string", "minLength": 5, "maxLength": 600 }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "eval-run" } } }, "then": { "required": ["result", "gate", "metrics"] } }
        ]
      }
    }
  }
}
