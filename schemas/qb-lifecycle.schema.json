{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zeptly:qb:schema:lifecycle:v1",
  "title": "Lifecycle Overlay",
  "description": "Append-only history of lifecycle states (active, deprecated, revoked). Independent of maturity and origin. The last entry is the effective state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "entries"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/apiVersion"
    },
    "kind": {
      "const": "LifecycleOverlay"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "id",
        "version"
      ],
      "properties": {
        "registry": {
          "const": "qb-agents"
        },
        "id": {
          "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/artifactId"
        },
        "version": {
          "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/semver"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "at",
          "actor",
          "reason"
        ],
        "properties": {
          "state": {
            "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/lifecycle"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/actor"
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "replacedBy": {
            "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/exactRef"
          }
        }
      }
    }
  }
}
