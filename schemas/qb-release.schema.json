{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zeptly:qb:schema:release:v1",
  "title": "Release Record",
  "description": "Written when a version is promoted to `canonical`. Aligned with the index record (same identity and artifact digest) and carries the directory seal over the canonical payload files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "digestAlgorithm",
    "digest",
    "directorySeal",
    "payload",
    "sealedAt"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/apiVersion"
    },
    "kind": {
      "const": "ReleaseRecord"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "id",
        "version"
      ],
      "properties": {
        "registry": {
          "const": "qb-agents"
        },
        "id": {
          "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/artifactId"
        },
        "version": {
          "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/semver"
        }
      }
    },
    "digest": {
      "description": "Artifact digest (excludes metadata.version/maturity/lifecycle, approvals, attestations).",
      "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/digest"
    },
    "sealedAt": {
      "type": "string",
      "format": "date-time"
    },
    "promotionRef": {
      "type": "string",
      "description": "Governance transport reference (e.g. a pull request); transport only, not part of identity."
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "actor",
          "at"
        ],
        "properties": {
          "type": {
            "enum": [
              "security-review",
              "release-approval"
            ]
          },
          "actor": {
            "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/actor"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "directorySeal": {
      "description": "sha256 over canonical JSON of {registry,id,version,payload}; binds the version.",
      "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/digest"
    },
    "payload": {
      "description": "Canonical payload files and their digests, sorted by POSIX path in code-point order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest"
        ],
        "properties": {
          "path": {
            "enum": [
              "blueprint.yaml",
              "evals/suite.yaml"
            ]
          },
          "digest": {
            "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/digest"
          }
        }
      }
    },
    "digestAlgorithm": {
      "$ref": "urn:zeptly:qb:schema:common:v1#/$defs/digestAlgorithm"
    }
  }
}
