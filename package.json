{
  "name": "@zeptly/registry-qb-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical Git-native registry of Zeptly QB (Quarterback) Agent blueprints",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "check:immutability": "node scripts/check-immutability.mjs",
    "build:index": "node scripts/build-index.mjs",
    "seal": "node scripts/seal.mjs",
    "test": "node --test test/*.test.mjs",
    "ci": "npm run validate && npm test && npm run build:index"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "semver": "^7.6.3",
    "yaml": "^2.5.1"
  }
}
